// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ✅ Enums, models, etc. start *after* the datasource block

enum Role {
  USER
  MEMBER
  MODERATOR
  ADMIN
  BOT
  TEAM
}

// A team is a User row with role = TEAM. See docs/teams.md.
//
// EMERITUS is a former member who left of their own accord. Removal by someone
// else deletes the row instead, because removal usually means the membership
// was a mistake and listing them as an alumnus would be wrong.
enum MembershipState {
  PENDING
  ACTIVE
  EMERITUS
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  fullName     String?
  givenName    String?
  familyName   String?
  email        String?
  avatarUrl    String?   @default("")
  passwordHash String?   @default("")
  role           Role      @default(USER)
  botSecret      String?
  canCreateUsers Boolean   @default(false)
  createdAt      DateTime  @default(now())

  kudosGiven    Kudos[]          @relation("FromUser")
  kudosReceived KudosRecipient[]
  badges        UserBadge[]

  followers Follow[] @relation("UserFollows")   // Users who follow THIS user
  following Follow[] @relation("UserFollowing") // Users THIS user follows
  socialHandles UserSocialHandle[]

  teamProfile     TeamProfile? @relation("TeamAccount")   // set when role = TEAM
  teamRoster      TeamMember[] @relation("TeamMemberTeam") // members OF this team
  teamMemberships TeamMember[] @relation("TeamMemberUser") // teams THIS user is in
  teamBadges      Badge[]      @relation("TeamBadge")      // badges bound to this team
}

// Extra attributes for a User with role = TEAM.
model TeamProfile {
  teamUserId  Int       @id
  description String?
  listEmail   String?   // public; team notifications fan out here
  homepage    String?
  chatUrl     String?
  createdById Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  teamUser User @relation("TeamAccount", fields: [teamUserId], references: [id], onDelete: Cascade)

  @@index([createdById])
}

model TeamMember {
  id           Int             @id @default(autoincrement())
  teamUserId   Int
  userId       Int
  state        MembershipState @default(PENDING)
  requestedAt  DateTime        @default(now())
  approvedAt   DateTime?
  approvedById Int?
  leftAt       DateTime?       // set when state becomes EMERITUS

  team User @relation("TeamMemberTeam", fields: [teamUserId], references: [id], onDelete: Cascade)
  user User @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamUserId, userId])
  @@index([userId])
}

// Append-only change log, shown on the team page.
model TeamEvent {
  id         Int      @id @default(autoincrement())
  teamUserId Int
  actorId    Int
  targetId   Int?
  action     String // created | requested | approved | auto_approved | left | removed
  createdAt  DateTime @default(now())

  @@index([teamUserId])
}

model UserSocialHandle {
  id        Int      @id @default(autoincrement())
  userId    Int
  network   String
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
  @@index([network])
}


model KudosCategory {
  id           Int             @id @default(autoincrement())
  code         String          @unique
  label        String
  icon         String
  defaultMsg   String?
  createdAt    DateTime        @default(now())
  kudos        Kudos[]
}

model Kudos {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  message       String?
  picture       String?
  groupHash     String?         // MD5 hash of sorted recipient usernames for grouping
  createdAt     DateTime        @default(now())
  fromUserId    Int
  categoryId    Int
  badgeId       Int?

  fromUser      User            @relation("FromUser", fields: [fromUserId], references: [id])
  category      KudosCategory   @relation(fields: [categoryId], references: [id])
  badge         Badge?          @relation(fields: [badgeId], references: [id])
  recipients    KudosRecipient[]

  @@index([groupHash])
}

model KudosRecipient {
  id         Int       @id @default(autoincrement())
  kudos      Kudos     @relation(fields: [kudosId], references: [id])
  kudosId    Int
  user       User      @relation(fields: [userId], references: [id])
  userId     Int

  // True when this recipient is a team and the sender was a member of it at the
  // time. Recorded at send time because rosters change: a team's standing should
  // rank on praise from outside, without blocking members from thanking their
  // own team. See docs/teams.md.
  internal   Boolean   @default(false)
}

model Badge {
  id           Int           @id @default(autoincrement())
  slug         String        @unique // pretty string
  title        String
  description  String
  picture      String
  link         String?
  kudos        Kudos[]
  userAwards   UserBadge[]
  createdAt    DateTime      @default(now())

  // Some badges predate teams and were used to mark team affiliation. Binding
  // one to a team makes it the team's emblem and keeps granting it a way into
  // the roster. The badge stays a permanent achievement either way: leaving
  // the team never takes it away. See docs/teams.md.
  teamUserId   Int?
  teamUser     User?         @relation("TeamBadge", fields: [teamUserId], references: [id])

  @@index([teamUserId])
}

model UserBadge {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  badge      Badge     @relation(fields: [badgeId], references: [id])
  badgeId    Int
  grantedAt  DateTime  @default(now())

  @@unique([userId, badgeId])
}

model Follow {
  followerId Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollows", fields: [followerId], references: [id])
  following User @relation("UserFollowing", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}